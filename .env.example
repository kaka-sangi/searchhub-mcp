# Issuer URL — public URL of THIS server (used in OAuth metadata)
ISSUER=http://localhost:3000

# JWT signing keys (HS256 for simplicity; rotate via env)
JWT_SIGNING_SECRET=replace-with-32-plus-random-chars-keep-secret

# Default scopes offered
DEFAULT_SCOPES=mcp:tools

# Where SQLite stores clients, auth codes, tokens
DATA_DIR=./data

# Upstream search MCP providers
